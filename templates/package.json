{
  "name": "your-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "test:perf": "playwright test --grep @perf",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:report": "playwright show-report",
    "codegen": "playwright codegen",
    "lint": "eslint tests/",
    "lint:fix": "eslint tests/ --fix",
    "typecheck": "tsc --noEmit",
    "validate": "./tools/validate-suite.sh ./tests && npm run lint && npm run typecheck",
    "score": "node ./tools/score-tests.js ./tests --threshold=80",
    "install:browsers": "playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.10.0",
    "eslint-plugin-playwright": "^2.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
